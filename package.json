{
    "name": "darkwind",
    "publisher": "BlakeDev",
    "displayName": "Darkwind",
    "description": "A dark Visual Studio Code theme inspired by Tailwind's color palette",
    "version": "1.0.4",
    "license": "MIT",
    "engines": {
        "vscode": "^1.56.0"
    },
    "icon": "icon.png",
    "categories": [
        "Themes"
    ],
    "keywords": [
        "dark",
        "theme",
        "tailwind",
        "syntax highlighting"
    ],
    "homepage": "https://blakecampbell.com/uses/#darkwind",
    "bugs": {
        "url": "https://github.com/BlakeCampbells/Darkwind/issues"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/BlakeCampbells/Darkwind"
    },
    "scripts": {
        "test": "node --test",
        "package": "npm test && vsce package --no-dependencies",
        "package:contents": "vsce ls --no-dependencies"
    },
    "devDependencies": {
        "@vscode/vsce": "4.1.1"
    },
    "contributes": {
        "themes": [
            {
                "label": "Darkwind",
                "uiTheme": "vs-dark",
                "path": "./themes/Darkwind-color-theme.json"
            }
        ]
    },
    "galleryBanner": {
        "color": "#111827",
        "theme": "dark"
    }
}
